<odoo>
    <template id="report_stock_analytics_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="payload" t-value="wizard.get_report_payload()"/>
                <t t-set="metadata" t-value="payload.get('metadata', {})"/>
                <t t-call="web.external_layout">
                    <div class="page stock-analytics-pdf">
                        <style>
                            .stock-analytics-pdf table{width:100%;border-collapse:collapse;font-size:9px;page-break-inside:auto}.stock-analytics-pdf th{background:#1f4e78;color:white}.stock-analytics-pdf th,.stock-analytics-pdf td{border:1px solid #999;padding:3px;vertical-align:top}.stock-analytics-pdf h2{margin-bottom:4px}.stock-analytics-pdf .meta span{display:inline-block;margin-right:18px}.stock-analytics-pdf .section{page-break-before:auto;margin-top:12px}.stock-analytics-pdf .section.large{page-break-before:always}
                        </style>
                        <h2>Inventory Advanced Analytics Dashboard</h2>
                        <h4><t t-esc="payload.get('report_type')"/></h4>
                        <div class="meta">
                            <span><strong>Company:</strong> <t t-esc="metadata.get('company')"/></span>
                            <span><strong>Generated by:</strong> <t t-esc="metadata.get('generated_by')"/></span>
                            <span><strong>Generated:</strong> <t t-esc="metadata.get('generated_at')"/></span>
                            <span><strong>Timezone:</strong> <t t-esc="metadata.get('timezone')"/></span>
                        </div>
                        <p><strong>Filters:</strong> <t t-esc="metadata.get('filters')"/></p>
                        <t t-foreach="payload.get('sections', {}).items()" t-as="section">
                            <div t-attf-class="section #{len(section[1]) &gt; 20 and 'large' or ''}">
                                <h3><t t-esc="section[0]"/></h3>
                                <t t-if="not section[1]"><p>No data for selected filters.</p></t>
                                <t t-if="section[1]">
                                    <t t-set="rows" t-value="section[1] if isinstance(section[1], list) else [section[1]]"/>
                                    <t t-set="headers" t-value="list(rows[0].keys()) if rows and isinstance(rows[0], dict) else ['value']"/>
                                    <table>
                                        <thead><tr><t t-foreach="headers" t-as="head"><th><t t-esc="head"/></th></t></tr></thead>
                                        <tbody>
                                            <t t-foreach="rows[:60]" t-as="row">
                                                <tr><t t-foreach="headers" t-as="head"><td><t t-esc="(row.get(head, '') if isinstance(row, dict) else row)"/></td></t></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                    <t t-if="len(rows) &gt; 60"><p>Showing first 60 rows in PDF. Use Excel for complete detail.</p></t>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
