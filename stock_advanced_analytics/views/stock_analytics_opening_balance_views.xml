<odoo>
    <record id="view_stock_analytics_opening_balance_tree" model="ir.ui.view">
        <field name="name">stock.analytics.opening.balance.tree</field><field name="model">stock.analytics.opening.balance</field>
        <field name="arch" type="xml"><tree><field name="product_id"/><field name="location_id"/><field name="opening_date"/><field name="quantity"/><field name="uom_id"/><field name="company_id"/><field name="active"/></tree></field>
    </record>
    <record id="view_stock_analytics_opening_balance_form" model="ir.ui.view">
        <field name="name">stock.analytics.opening.balance.form</field><field name="model">stock.analytics.opening.balance</field>
        <field name="arch" type="xml"><form string="Opening Balances"><sheet><group><field name="product_id"/><field name="location_id"/><field name="opening_date"/><field name="quantity"/><field name="uom_id"/><field name="company_id"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_stock_analytics_opening_balance" model="ir.actions.act_window">
        <field name="name">Opening Balances</field><field name="res_model">stock.analytics.opening.balance</field><field name="view_mode">tree,form</field>
    </record>
</odoo>