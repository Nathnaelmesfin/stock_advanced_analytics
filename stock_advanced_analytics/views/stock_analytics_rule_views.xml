<odoo>
    <record id="view_stock_analytics_rule_tree" model="ir.ui.view">
        <field name="name">stock.analytics.rule.tree</field><field name="model">stock.analytics.rule</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="product_id"/><field name="product_category_id"/><field name="warehouse_id"/><field name="location_id"/><field name="minimum_quantity"/><field name="maximum_quantity"/><field name="reorder_quantity"/><field name="active"/><field name="company_id"/></tree></field>
    </record>
    <record id="view_stock_analytics_rule_form" model="ir.ui.view">
        <field name="name">stock.analytics.rule.form</field><field name="model">stock.analytics.rule</field>
        <field name="arch" type="xml"><form string="Stock Rules"><sheet><group><field name="name"/><field name="product_id"/><field name="product_category_id"/><field name="warehouse_id"/><field name="location_id"/><field name="minimum_quantity"/><field name="maximum_quantity"/><field name="reorder_quantity"/><field name="active"/><field name="company_id"/></group></sheet></form></field>
    </record>
    <record id="action_stock_analytics_rule" model="ir.actions.act_window">
        <field name="name">Stock Rules</field><field name="res_model">stock.analytics.rule</field><field name="view_mode">tree,form</field>
    </record>
</odoo>