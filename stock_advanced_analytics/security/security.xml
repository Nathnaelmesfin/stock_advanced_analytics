<odoo>
    <record id="module_category_stock_analytics" model="ir.module.category">
        <field name="name">Inventory Analytics</field>
        <field name="description">Inventory Advanced Analytics access groups</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_stock_analytics_user" model="res.groups">
        <field name="name">Inventory Analytics User</field>
        <field name="category_id" ref="stock_advanced_analytics.module_category_stock_analytics"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_stock_analytics_manager" model="res.groups">
        <field name="name">Inventory Analytics Manager</field>
        <field name="category_id" ref="stock_advanced_analytics.module_category_stock_analytics"/>
        <field name="implied_ids" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="rule_stock_analytics_location_map_company" model="ir.rule">
        <field name="name">Location mappings multi-company</field>
        <field name="model_id" ref="model_stock_analytics_location_map"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user'))]"/>
    </record>
    <record id="rule_stock_analytics_operation_map_company" model="ir.rule">
        <field name="name">Operation mappings multi-company</field>
        <field name="model_id" ref="model_stock_analytics_operation_map"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user'))]"/>
    </record>
    <record id="rule_stock_analytics_status_map_company" model="ir.rule">
        <field name="name">Status mappings multi-company</field>
        <field name="model_id" ref="model_stock_analytics_status_map"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user'))]"/>
    </record>
    <record id="rule_stock_analytics_rule_company" model="ir.rule">
        <field name="name">Stock analytics rules multi-company</field>
        <field name="model_id" ref="model_stock_analytics_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user'))]"/>
    </record>
    <record id="rule_stock_analytics_opening_balance_company" model="ir.rule">
        <field name="name">Opening balances multi-company</field>
        <field name="model_id" ref="model_stock_analytics_opening_balance"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock_advanced_analytics.group_stock_analytics_user'))]"/>
    </record>
</odoo>
